# Copia este archivo a ".env" y completa los valores.

PORT=4000
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# 'remote' (por defecto) o 'local' (carga ademas .env.local, ver
# .env.local.example y README -> "Alternar entre local y remoto").
DB_MODE=remote

# Unico usuario admin (por ahora no hay creacion de cuentas)
ADMIN_USER=admin
ADMIN_PASS=admin

# ---------------------------------------------------------------------------
# Conexiones a las bases de datos de cada proyecto.
# Copia el valor MONGO_URI / MONGODB_URI / DB_CNN / DATABASE_URL que ya
# tiene el .env de cada backend en mios/<proyecto>/.env
# Si dejas una vacia, esa tarjeta del dashboard se muestra como
# "Desconectado" en vez de romper el resto del panel.
# ---------------------------------------------------------------------------

# Habanera (MongoDB)
HABANERA_MONGO_URI=

# FitApp (MongoDB) -> sin base de datos real desplegada todavia
FITAPP_MONGO_URI=

# CurbRadar (MongoDB)
CUBRADAR_MONGO_URI=

# FixRadar (MongoDB)
FIXRADAR_MONGO_URI=

# DealSnap (MongoDB)
DEALSNAP_MONGO_URI=

# Kambalache (MongoDB)
KAMBALACHE_MONGO_URI=

# Invoice Snap (PostgreSQL / Prisma). Si Postgres esta detras de un tunel
# SSH (ver README), usa localhost:<puerto-local-del-tunel> aqui.
INVOICESNAP_DATABASE_URL=

# ---------------------------------------------------------------------------
# Firebase Admin: para generar el link de "restablecer contraseña" de
# proyectos que usan Firebase Auth. Ver README -> "Reset de contraseña".
# Ruta a un JSON de cuenta de servicio (Firebase Console -> Configuracion
# del proyecto -> Cuentas de servicio -> Generar nueva clave privada).
# Guardalo en secrets/ (ignorada por git), nunca en el repo.
# ---------------------------------------------------------------------------
CURBRADAR_FIREBASE_SERVICE_ACCOUNT_PATH=
FIXRADAR_FIREBASE_SERVICE_ACCOUNT_PATH=

# ---------------------------------------------------------------------------
# SMTP para ENVIAR el correo con el link/contraseña de reseteo. Si lo dejas
# vacio, el dashboard no envia nada solo: te muestra el resultado en pantalla
# para que tu decidas como mandarlo.
# ---------------------------------------------------------------------------
RESET_EMAIL_SMTP_HOST=
RESET_EMAIL_SMTP_PORT=587
RESET_EMAIL_SMTP_SECURE=false
RESET_EMAIL_SMTP_USER=
RESET_EMAIL_SMTP_PASS=
RESET_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Metricas de instalaciones/ventas desde las tiendas. Ver README ->
# "Instalaciones desde Google Play / App Store" para el paso a paso.
# ---------------------------------------------------------------------------
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_REPORTS_BUCKET=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY_PATH=
APP_STORE_CONNECT_VENDOR_NUMBER=
