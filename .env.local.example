# Copia esto a ".env.local" (archivo ignorado por git) para personalizar
# tus conexiones locales. Solo necesitas poner las variables que quieras
# REEMPLAZAR respecto a lo que ya hay en ".env" -- las que no pongas aqui
# se quedan con el valor de ".env" (normalmente el del servidor remoto).
#
# Para activarlo: pon DB_MODE=local en tu .env y reinicia el servidor.
# Para volver al servidor remoto: DB_MODE=remote (o borra la linea).
#
# Requisito: tener un mongod corriendo en tu Mac (brew services start
# mongodb-community, o el que uses). Estas bases locales normalmente estan
# vacias o con datos de prueba -- no son una copia de produccion.

CUBRADAR_MONGO_URI=mongodb://localhost:27017/curbradar
FIXRADAR_MONGO_URI=mongodb://localhost:27017/fixradar
KAMBALACHE_MONGO_URI=mongodb://localhost:27017/kambalache

# Habanera, DealSnap e Invoice Snap no tienen un backend corriendo en tu Mac
# todavia -> si los agregas aqui, apunta a donde SI los tengas corriendo
# localmente (otro puerto de Mongo, otro Postgres, etc). Si no los pones,
# en modo local siguen usando la URI remota de ".env" (no se rompen).
# HABANERA_MONGO_URI=
# DEALSNAP_MONGO_URI=
# INVOICESNAP_DATABASE_URL=
